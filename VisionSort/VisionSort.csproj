<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- VisionPro 9.0 (59.2.0.0) 是 .NET Framework 4.0 / x64 混合模式程序集，
         宿主必须落在 .NET Framework 4.x 且 64 位。界面层保持纯 WinForms、
         不引用任何 Cognex 程序集，保证在未安装 VisionPro 的机器上也能用
         VS 设计器正常预览。联调时再把预留的 Panel 替换为 CogRecordDisplay。 -->
    <TargetFramework>net48</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VisionSort</RootNamespace>
    <AssemblyName>VisionSort</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- 机械臂通信的独立项目：x86 桥接进程的 IPC 客户端（不引用任何 Cognex/WinForms，
         可单独编译与测试，见 机械臂TCP控制方案.md §5.1）。 -->
    <ProjectReference Include="..\DobotArm\DobotArm.csproj" />

    <!-- 桥接进程（x86 控制台，唯一宿主官方 DobotDll.dll 的地方）：只借它的**构建顺序**，
         **不能引用它的程序集**——它是 x86 exe，引进来会把 x86 目标带进 x64 进程。 -->
    <ProjectReference Include="..\DobotArmBridge\DobotArmBridge.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 九点标定的操作指引：**唯一真相源是那个 .md 文件**，这里把它嵌进 exe 供
         「操作指引」按钮弹出显示（见 九点标定联机分拣方案.md §4.10.1）。
         为什么不硬编码一份字符串在代码里：硬编码的第二份迟早和文档分叉，
         而"以文档为准"这句话在实践中没人会去核对。改了 .md 重新编译，程序里的字就跟着变。 -->
    <EmbeddedResource Include="..\九点标定操作指引.md">
      <LogicalName>VisionSort.九点标定操作指引.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

