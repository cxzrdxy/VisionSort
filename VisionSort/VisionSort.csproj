  <!-- 把桥接进程（exe + 6 个官方原生 DLL）拷到输出目录的 ArmBridge\ 下，
       VisionSort 运行时会去那里拉起它（见 DobotArmSettings.BridgeExePath）。
       注意必须写成 Target 而不是 ItemGroup：项目评估 glob 时桥接进程可能还没构建过，
       那时 glob 是空的，会静默漏拷（这是最容易被忽略的部署坑）。 -->
  <Target Name="CopyArmBridge" AfterTargets="Build">
    <ItemGroup>
      <ArmBridgeFiles Include="..\DobotArmBridge\bin\$(Configuration)\net48\**\*"
                      Exclude="..\DobotArmBridge\bin\$(Configuration)\net48\**\*.pdb;..\DobotArmBridge\bin\$(Configuration)\net48\**\*.log" />
    </ItemGroup>
    <Copy SourceFiles="@(ArmBridgeFiles)" DestinationFolder="$(OutDir)ArmBridge\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="normal" Text="机械臂桥接进程已拷到 $(OutDir)ArmBridge\（@(ArmBridgeFiles->Count()) 个文件）" />
  </Target>

</Project>
