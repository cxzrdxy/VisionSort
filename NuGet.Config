<?xml version="1.0" encoding="utf-8"?>
<!-- 这两个项目（VisionSort / DobotArm 类库）没有任何 NuGet 包依赖：
       第三方库都是本地文件引用（Cognex 走 HintPath、NModbus 在 VisionSort\Libs），
       所以这里把包源清空，让 restore 完全离线完成，避免现场/离线机器卡在 nuget.org。 -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
